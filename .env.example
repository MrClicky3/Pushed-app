# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Both values are safe to expose in a browser bundle: the anon key is a
# publishable key, and every table is protected by Supabase row-level security.
# Find them at: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Used by api/report.ts (the Vercel serverless function behind
# bug reports). Set it in the Vercel dashboard, NOT here — this one is a real
# secret and must never reach the browser. Bug reporting is simply disabled in
# any environment where it is unset.
# RESEND_API_KEY=
